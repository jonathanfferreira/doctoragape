# Chatwoot production configuration example - Doctor Agape
# Copy to .chatwoot.env (never commit the real file) and fill every placeholder.
# Unlike the local dev setup generated by configure.py, this template keeps
# account signup closed and forces TLS: a patient-facing communication channel
# must never run with open signup or plain HTTP.
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
FRONTEND_URL=https://chatwoot.example.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
POSTGRES_HOST=chatwoot-db
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=<generate-with-secret>
REDIS_URL=redis://:<generate-with-secret>@chatwoot-redis:6379
SECRET_KEY_BASE=<generate-with-secret>
RAILS_LOG_TO_STDOUT=true
ACTIVE_STORAGE_SERVICE=local
DEFAULT_LOCALE=pt_BR
# Additional production requirements (not covered by env vars alone):
# - Terminate TLS at a reverse proxy and redirect HTTP to HTTPS.
# - Do not bind ports to the host without a firewall/reverse proxy in front.
# - Keep image tags pinned (consider digests) and review upstream advisories.
# - Restrict database and Redis to the compose network (no host ports).
# - Keep clinical data out of chat channels; minimize personal data in messages.
